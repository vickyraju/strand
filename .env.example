# Build-time settings of the web app (baked into the static build by `npm run build`).
# The API, as the browser reaches it: the CloudFront domain that fronts /api/v1.
VITE_API_URL=https://app.example.com
# Microsoft Entra ID: the single-page-application registration for the web app.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Only for a sovereign cloud, e.g. https://login.microsoftonline.us
# VITE_ENTRA_AUTHORITY=
