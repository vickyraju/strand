# Build-time settings of the web app (baked into the static build by `npm run build`).
# The API, as the browser reaches it: the CloudFront domain that fronts /api/v1.
VITE_API_URL=https://app.example.com
# How people sign in (Microsoft Entra, the login form) is not built in: the app reads it from the API at start
# (Administration › Authentication methods).
