# Configuration of the API container. In AWS these come from the Kubernetes Secret / ConfigMap (see deploy/k8s), never from a file in the image.
PORT=3001
NODE_ENV=production

# Aurora PostgreSQL through RDS Proxy. Use sslmode=verify-full; the image already trusts the RDS CA bundle.
DATABASE_URL=postgresql://USER:PASSWORD@PROXY-ENDPOINT:5432/DATABASE?sslmode=verify-full
# The Aurora writer's own endpoint (not RDS Proxy). Live updates use LISTEN/NOTIFY, which needs a session that stays open;
# the migration job takes its lock here too.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@WRITER-ENDPOINT:5432/DATABASE?sslmode=verify-full
PG_POOL=10

# Microsoft Entra ID, read once: on first start they become Administration › Authentication methods, which wins from
# then on. The one company tenant, the API app registration's client id, and the web app registration's client id.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
# Only for a sovereign cloud, e.g. https://login.microsoftonline.us
# ENTRA_AUTHORITY=

# Recovery mode (16 characters or more): while set, `recovery_admin` signs in with it through the login form at
# /?auth_fallback, as a system administrator, to restore sign-in. Remove it afterwards.
# STRAND_RECOVERY_PASSWORD=

# Shared bearer token Entra uses when provisioning users over SCIM (/scim/v2). Unset = SCIM refuses every call.
SCIM_TOKEN=

# Attachments: the S3 bucket. Credentials come from the pod's IAM role (IRSA).
S3_BUCKET=
AWS_REGION=

# Browser origins allowed to call the API cross-origin (comma-separated). Leave empty when CloudFront serves the app and /api/v1 from one domain.
CORS_ORIGINS=

# Serve Swagger UI at /docs. Off by default.
DOCS_ENABLED=

# GitHub webhook secret. Unset = the webhook endpoint refuses everything.
GITHUB_WEBHOOK_SECRET=
