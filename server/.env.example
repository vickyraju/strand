# Postgres. Dev: Neon, the DIRECT host (no "-pooler", LISTEN/NOTIFY needs it) with ?sslmode=require. Prod: Aurora via RDS Proxy.
# Local alternative: any Postgres 14+ (default below).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PG_POOL=10
PORT=3001

# Auth: Microsoft Entra ID (single company tenant). AUTH_DEV=1 trusts an x-dev-user header; never set in prod.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# The web app registration's client id. ENTRA_* are read once: on first start they become Administration ›
# Authentication methods (spec 0711), which wins from then on.
ENTRA_WEB_CLIENT_ID=
# Recovery mode (16 characters or more): while set, `recovery_admin` signs in with it through the login form at
# /?auth_fallback, as a system administrator, to restore sign-in. Remove it afterwards.
# STRAND_RECOVERY_PASSWORD=
AUTH_DEV=1
# Required for AUTH_DEV unless NODE_ENV is development/test (e.g. the Render dev deploy); clients send it as x-dev-secret
DEV_AUTH_SECRET=

# Key for secrets Strand stores, such as a user directory's service account password (spec 0712): 32 characters or
# more, kept in the Kubernetes Secret. Changing it means typing those passwords again.
# STRAND_SECRET_KEY=

# Shared secret Entra sends when provisioning users over SCIM (/scim/v2)
SCIM_TOKEN=

# Attachments. Dev: any S3-compatible endpoint (e.g. Cloudflare R2) or a dev bucket. Prod: S3 with pod IAM role (IRSA), leave S3_ENDPOINT unset.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1

# Origins allowed to call the API from a browser (comma-separated). Unset = none.
CORS_ORIGINS=http://localhost:5173

# GitHub App webhook secret (the same random string you type into the App's "Webhook secret"). Unset = the webhook refuses everything.
GITHUB_WEBHOOK_SECRET=

# Serve Swagger UI at /docs (always on for NODE_ENV=development; opt-in elsewhere, keep off in production)
DOCS_ENABLED=
