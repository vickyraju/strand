# Configuration of the API. Set these in the server's environment; keep secrets out of files that are committed.
PORT=3001
NODE_ENV=production

# PostgreSQL 15+, directly or through a connection pooler. Use sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# The database itself (not a transaction pooler). Live updates use LISTEN/NOTIFY, which needs a session that stays open;
# migrations take their lock here too. Unset = DATABASE_URL.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
PG_POOL=10

# Microsoft Entra ID, read once: on first start they become Administration › Authentication methods, which wins from
# then on. The one company tenant, the API app registration's client id, and the web app registration's client id.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
# Only for a sovereign cloud, e.g. https://login.microsoftonline.us
# ENTRA_AUTHORITY=

# Recovery mode (16 characters or more): while set, `recovery_admin` signs in with it through the login form at
# /?auth_fallback, as a system administrator, to restore sign-in. Remove it afterwards.
# RECOVERY_PASSWORD=

# Key for secrets the app stores, such as a user directory's service account password (spec 0712): 32 characters or
# more, kept with the server's other secrets. Changing it means typing those passwords again.
# SECRET_KEY=

# Shared bearer token Entra uses when provisioning users over SCIM (/scim/v2). Unset = SCIM refuses every call.
SCIM_TOKEN=

# Attachments and backups: the S3 bucket. Credentials come from the standard AWS SDK chain.
# S3_ENDPOINT points at another S3-compatible store.
S3_BUCKET=
AWS_REGION=
# S3_ENDPOINT=

# Browser origins allowed to call the API cross-origin (comma-separated). Leave empty when one domain serves the app and /api/v1.
CORS_ORIGINS=

# The proxies in front of the API that may name the client's address (X-Forwarded-For): a hop count ("1" behind one
# load balancer), or their addresses and CIDRs, comma-separated. Unset = none (the connection's address is used).
TRUST_PROXY=

# Serve Swagger UI at /docs. Off by default.
DOCS_ENABLED=

# GitHub webhook secret. Unset = the webhook endpoint refuses everything.
GITHUB_WEBHOOK_SECRET=
