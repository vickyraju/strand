# Postgres. Dev: Neon, the DIRECT host (no "-pooler", LISTEN/NOTIFY needs it) with ?sslmode=require. Prod: Aurora via RDS Proxy.
# Local alternative: any Postgres 14+ (default below).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PG_POOL=10
PORT=3001

# Auth: Microsoft Entra ID (single company tenant). AUTH_DEV=1 trusts an x-dev-user header; never set in prod.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
AUTH_DEV=1
# Required for AUTH_DEV unless NODE_ENV is development/test (e.g. the Render dev deploy); clients send it as x-dev-secret
DEV_AUTH_SECRET=
# Shared secret Entra sends when provisioning users over SCIM (/scim/v2)
SCIM_TOKEN=

# Attachments. Dev: any S3-compatible endpoint (e.g. Cloudflare R2) or a dev bucket. Prod: S3 with pod IAM role (IRSA), leave S3_ENDPOINT unset.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1

# Origins allowed to call the API from a browser (comma-separated). Unset = none.
CORS_ORIGINS=http://localhost:5173

# Serve Swagger UI at /docs (always on for NODE_ENV=development; opt-in elsewhere, keep off in production)
DOCS_ENABLED=
