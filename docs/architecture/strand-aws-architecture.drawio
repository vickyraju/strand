      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b style=&quot;font-size:26px&quot;&gt;Strand on AWS: production architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#545B64&quot;&gt;Target state. React SPA behind CloudFront; Node.js API on EKS; Aurora PostgreSQL as the system of record; Microsoft Entra ID for sign-in and provisioning. Dashed red = needs application work that is not built yet.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="1800" height="70" as="geometry"/>
        </mxCell>
