        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;On failover (runbook):&lt;/b&gt; promote the Aurora secondary · scale Karpenter node pools up · point Route 53 and CloudFront at region B · re-enable the SQS workers. Rehearse twice a year." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="regB">
          <mxGeometry x="20" y="700" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Normal operation:&lt;/b&gt; all traffic is served here. Aurora Global Database copies storage to region B (typically under a second). S3 and ECR replication copy files and images." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="regA">
          <mxGeometry x="20" y="700" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Recovery targets (indicative, to be agreed)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#879196;dashed=0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
