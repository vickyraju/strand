        <mxCell id="r_notifications_created_at" value="created_at" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=40;fontSize=11;fontStyle=0;fontColor=#232F3E;whiteSpace=nowrap;overflow=hidden;strokeColor=none;fillColor=#ffffff;" vertex="1" parent="t_notifications">
