        <mxCell id="c495" value="timestamptz" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#6B7280;pointerEvents=0;" vertex="1" parent="t_notifications">
          <mxGeometry x="128" y="206" width="146" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c557" value="Conventions &amp;amp; legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=none;dashed=0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="718" y="2986" width="560" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="c558" value="&lt;b&gt;Keys.&lt;/b&gt; uuid v7 primary keys (time-ordered). Every tenant table carries &lt;b&gt;workspace_id&lt;/b&gt; or hangs off a table that does. References to &lt;b&gt;workspaces&lt;/b&gt; and &lt;b&gt;users&lt;/b&gt; from other domains are written in the column (&lt;i&gt;uuid → users&lt;/i&gt;) instead of drawn, to keep the lines readable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="40" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c559" value="&lt;b&gt;Access.&lt;/b&gt; Row-level security is &lt;b&gt;on, with no policies&lt;/b&gt;: only the API (a privileged role) reads or writes. Authorisation is in the API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="84" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c560" value="&lt;b&gt;Deletes.&lt;/b&gt; Issues are soft-deleted (&lt;b&gt;deleted_at&lt;/b&gt;) so Undo can restore them. Everything else cascades from its parent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="128" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c561" value="&lt;b&gt;Concurrency.&lt;/b&gt; &lt;b&gt;issues.version&lt;/b&gt; is sent as If-Match on edits; a stale edit gets 409. &lt;b&gt;rank&lt;/b&gt; is fractional, so a move rewrites one row." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="172" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c562" value="&lt;b&gt;Flexible data.&lt;/b&gt; jsonb for shapes that vary: custom field values, board prefs, layout, rule triggers/actions, view filters, integration payloads." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="216" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c563" value="&lt;b&gt;Search.&lt;/b&gt; issues.&lt;b&gt;search&lt;/b&gt; is a generated tsvector (GIN); titles also have a trigram index. Partial indexes skip deleted rows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="260" width="528" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="c564" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
          <mxGeometry x="16" y="316" width="120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="c565" value="&lt;b style=&quot;color:#9A6700&quot;&gt;PK&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c557">
