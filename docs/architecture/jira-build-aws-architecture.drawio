        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c2" value="&lt;b style=&quot;font-size:26px&quot;&gt;jira-build on AWS: disaster recovery (pilot light) and where data lives&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#545B64&quot;&gt;A second region keeps the database and files replicated and the compute scaled down. Failover is a runbook step, not automatic. Targets are indicative and need agreeing.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="20" y="14" width="2000" height="70" as="geometry"/>
                </mxCell>
