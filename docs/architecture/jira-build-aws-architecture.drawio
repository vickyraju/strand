                </mxCell>
                <mxCell id="kmsB" value="KMS&lt;br&gt;multi-Region keys" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=nowrap;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="regB">
                    <mxGeometry x="480" y="308" width="56" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="sqsB" value="SQS&lt;br&gt;empty queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=nowrap;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="regB">
                    <mxGeometry x="480" y="432" width="56" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="cacheB" value="ElastiCache&lt;br&gt;cold start" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=nowrap;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" vertex="1" parent="regB">
                    <mxGeometry x="480" y="556" width="56" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="&lt;b&gt;On failover (runbook):&lt;/b&gt; promote the Aurora secondary · scale Karpenter node pools up · point Route 53 and CloudFront at region B · re-enable the SQS workers. Rehearse twice a year." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="regB">
                    <mxGeometry x="20" y="700" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="&lt;b&gt;Normal operation:&lt;/b&gt; all traffic is served here. Aurora Global Database copies storage to region B (typically under a second). S3 replication copies the files." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="regA">
                    <mxGeometry x="20" y="700" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c12" value="Recovery targets (indicative, to be agreed)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#879196;dashed=0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
                    <mxGeometry x="1620" y="100" width="760" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="c13" value="&lt;b&gt;Scenario&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="44" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c14" value="&lt;b&gt;RPO&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="44" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c15" value="&lt;b&gt;RTO&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="44" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c16" value="Pod or node failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="84" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c17" value="0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="84" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c18" value="seconds (rescheduled)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="84" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c19" value="Availability Zone outage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="124" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c20" value="0 (Multi-AZ Aurora)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="124" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c21" value="about 1 to 2 minutes (failover)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="124" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c22" value="Region outage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="164" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c23" value="about 1 minute (Global DB lag)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="164" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c24" value="30 to 60 minutes (runbook)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="164" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c25" value="Bad deploy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="204" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c26" value="0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="204" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c27" value="minutes (rollback to previous image)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="204" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c28" value="Data corruption / mistake" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="14" y="244" width="256" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c29" value="point in time, to the second" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="284" y="244" width="226" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c30" value="hours (restore to a new cluster)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c12">
                    <mxGeometry x="514" y="244" width="246" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="c31" value="Where data lives and what each AWS service is for" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#879196;dashed=0;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
                    <mxGeometry x="1620" y="430" width="760" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="c32" value="&lt;b&gt;Aurora PostgreSQL.&lt;/b&gt; system of record: projects, issues, comments, users, history. Automated backups and point-in-time recovery; replicated to region B." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="44" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c33" value="&lt;b&gt;RDS Proxy.&lt;/b&gt; pools database connections from the API pods and speeds up failover." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="100" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c34" value="&lt;b&gt;S3.&lt;/b&gt; attachment files and the web app build. Versioned, encrypted with KMS, replicated to region B." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="156" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c35" value="&lt;b&gt;ElastiCache.&lt;/b&gt; ephemeral: rate-limit counters, cached project configuration. Safe to lose." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="212" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c36" value="&lt;b&gt;SQS.&lt;/b&gt; in-flight background jobs only. Jobs are retried; the database is the source of truth." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="268" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c37" value="&lt;b&gt;Secrets Manager and KMS.&lt;/b&gt; database credentials and encryption keys. Replicated; rotated on a schedule." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="c31">
                    <mxGeometry x="14" y="324" width="732" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="c38" value="&lt;b&gt;Notes.&lt;/b&gt; Region, instance sizes and recovery targets are placeholders to confirm. Region B runs only the data replicas until a failover is declared. Container images come from JFrog Artifactory; how it is made available to region B is to be agreed with its owners." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#545B64;strokeColor=none;dashed=0;spacing=4;fontStyle=0;" vertex="1" parent="1">
